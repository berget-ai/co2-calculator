{
  "name": "@berget/co2-emissions-calculator",
  "version": "1.0.0",
  "description": "Scientifically-grounded CO2 emissions calculator for AI inference based on SCI-AI specification",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build",
    "start:api": "tsx src/api/server.ts",
    "dev:api": "tsx watch src/api/server.ts"
  },
  "keywords": [
    "co2",
    "carbon",
    "emissions",
    "ai",
    "machine-learning",
    "sustainability",
    "sci-ai",
    "green-software"
  ],
  "author": "Berget <engineering@berget.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/berget-ai/co2-emissions-calculator.git"
  },
  "homepage": "https://github.com/berget-ai/co2-emissions-calculator#readme",
  "bugs": {
    "url": "https://github.com/berget-ai/co2-emissions-calculator/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "METHODOLOGY.md"
  ],
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "express": "^4.18.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "supertest": "^6.3.3",
    "tsx": "^4.0.0",
    "typescript": "^5.2.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js",
      "require": "./dist/api/index.js"
    }
  }
}
